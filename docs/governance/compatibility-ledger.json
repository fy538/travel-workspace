      "status": "retiring",
      "reason": "deployed_version_boundary",
      "owner": "mobile",
      "canonical": "You at /you",
      "paths": [
        "travel-app/app/(tabs)/atlas/index.tsx"
      ],
      "markers": [
        "compatibility_id: atlas-tab-url-bridge"
